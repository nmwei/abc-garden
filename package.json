{
  "name": "abc-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A gentle, offline-first alphabet garden for iPad.",
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "build": "node scripts/compile-context-vocabulary.mjs && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "test:subpath": "node tests/subpath.mjs",
    "audio:course": "node scripts/generate-course-audio.mjs",
    "assets:import": "node scripts/import-learning-assets.mjs",
    "audit:wonders": "node scripts/audit-wonders-gk.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "1.64.1",
    "kokoro-js": "1.2.1"
  }
}
