# Copy to a protected file outside Git and set GARDEN_ENV_FILE to its absolute path.
GARDEN_ORIGIN=http://localhost:4173
GARDEN_DATABASE=/absolute/private/directory/garden.sqlite
GARDEN_DELETION_LEDGER=/absolute/private/directory/deletions.jsonl
GARDEN_AUTH_SECRET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
PNVS_SIGN_NAME=
PNVS_TEMPLATE_CODE=
# Set this to the actual upper bound of your SMS price, in integer fen.
PNVS_UNIT_COST_FEN=6
GARDEN_REGISTRATION_OPEN=true
# Independent 32-byte hexadecimal key for encrypted database backups.
GARDEN_BACKUP_KEY=
